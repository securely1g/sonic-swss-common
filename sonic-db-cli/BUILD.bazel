load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@sonic_build_infra//cc:shared_library.bzl", "shared_library_cc_info")
load("//tools/bazel:cc.bzl", "swss_cc_binary", "swss_cc_library")
load("//tools/bazel:flags.bzl", "CXXFLAGS_COMMON", "DBGFLAGS")

swss_cc_library(
    name = "sonicdbcli",
    srcs = ["sonic-db-cli.cpp"],
    hdrs = ["sonic-db-cli.h"],
    cxxopts = DBGFLAGS + CXXFLAGS_COMMON,
    visibility = [
        "//tests:__pkg__",
    ],
    deps = ["//:libswsscommon"],
)

swss_cc_binary(
    name = "sonic-db-cli",
    srcs = ["main.cpp"],
    cxxopts = DBGFLAGS + CXXFLAGS_COMMON,
    visibility = ["//visibility:public"],
    deps = [":sonicdbcli"],
)

# Make installs this DSO as part of libswsscommon. Keep its public symbols
# separate from Common itself, and link against the same runtime library.
cc_shared_library(
    name = "libsonicdbcli.so.0",
    dynamic_deps = ["//:libswsscommon_consolidated.so"],
    shared_lib_name = "libsonicdbcli.so.0",
    user_link_flags = [
        "-Wl,-soname,libsonicdbcli.so.0",
        "-Wl,-z,now",
    ],
    visibility = ["//visibility:public"],
    deps = [":sonicdbcli"],
)

shared_library_cc_info(
    name = "sonicdbcli_so",
    shared_library = ":libsonicdbcli.so.0",
)

swss_cc_library(
    name = "sonicdbcli_shared",
    hdrs = ["sonic-db-cli.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":sonicdbcli_so",
        "//:libswsscommon_shared",
    ],
)

# Exercise a real consumer of the public DSO without requiring a Redis server.
cc_test(
    name = "shared_library_test",
    srcs = ["shared_library_test.cpp"],
    linkstatic = False,
    deps = [":sonicdbcli_shared"],
)
