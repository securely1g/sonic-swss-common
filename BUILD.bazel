# TODO(bazel-ready): Restore when we only support Bazel 8+
# load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
# load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//tools/bazel:cc.bzl", "swss_cc_binary")
load(
    "//tools/bazel:deps.bzl",
    "SWSS_COMMON_COPTS",
    "SWSS_COMMON_DEPS",
    "SWSS_COMMON_LINKOPTS",
)
load("//tools/bazel:flags.bzl", "CXXFLAGS_COMMON")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "gen_cfg_schema.py",
])

swss_common_hdrs = ["//common:hdrs"]

filegroup(
    name = "hdrs",
    srcs = swss_common_hdrs,
)

# Headers and external libraries needed by consumers of the shared Common library.
cc_library(
    name = "common_deps",
    linkopts = SWSS_COMMON_LINKOPTS,
    deps = SWSS_COMMON_DEPS,
)

cc_library(
    name = "common",
    srcs = ["//common:srcs"],
    hdrs = swss_common_hdrs,
    copts = [
        "-fPIC",
        "-std=c++14",
    ] + SWSS_COMMON_COPTS,
    includes = [
        "common",
    ],
    linkopts = SWSS_COMMON_LINKOPTS,
    visibility = ["//visibility:public"],
    deps = SWSS_COMMON_DEPS,
)

cc_library(
    name = "libswsscommon",
    hdrs = swss_common_hdrs,
    include_prefix = "swss",
    strip_include_prefix = "common",
    deps = [":common"],
)

# Keep bzlmod-only shared-library rules outside the static library's package.
# The Make-based P4RT build still consumes :libswsscommon with Bazel 6/WORKSPACE.
alias(
    name = "libswsscommon_consolidated.so",
    actual = "//shared:libswsscommon_consolidated.so",
)

alias(
    name = "libswsscommon_so",
    actual = "//shared:libswsscommon_so",
)

cc_library(
    name = "libswsscommon_shared",
    hdrs = swss_common_hdrs,
    include_prefix = "swss",
    # Consumers include these headers unprefixed, the way :common exposes them.
    includes = ["common"],
    strip_include_prefix = "common",
    deps = [
        ":common_deps",
        ":libswsscommon_so",
    ],
)

# Alias for compatibility with existing references
alias(
    name = "swsscommon_base",
    actual = ":common",
)

# Filegroups for swig bindings and other assets
filegroup(
    name = "all_hdrs",
    srcs = swss_common_hdrs,
)

filegroup(
    name = "swig_template",
    srcs = ["//pyext:swsscommon.i"],
)

filegroup(
    name = "all_luas",
    srcs = ["//common:luas"],
)

# TODO(bazel-ready): CFLAGS_COMMON is not respected yet in many of these targets.

swss_cc_binary(
    name = "swssloglevel",
    srcs = ["//common:loglevel_srcs"],
    cxxopts = CXXFLAGS_COMMON,
    linkopts = [
        "-Wl,-z,now",
    ],
    linkstatic = True,
    deps = ["libswsscommon"],
)

# Packaging lives in //dist, which is bzlmod-only, since it needs rules_distroless.
alias(
    name = "libswsscommon_pkg",
    actual = "//dist:libswsscommon_pkg",
)

alias(
    name = "libswsscommon_pkg.debug_symbols",
    actual = "//dist:libswsscommon_pkg.debug_symbols",
)

alias(
    name = "sonic-db-cli_pkg",
    actual = "//dist:sonic-db-cli_pkg",
)

alias(
    name = "sonic-db-cli_pkg.debug_symbols",
    actual = "//dist:sonic-db-cli_pkg.debug_symbols",
)
