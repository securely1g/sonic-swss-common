load("//tools/bazel:bzlmod.bzl", "IS_BZLMOD")
load("//tools/bazel/yang:cfg_schema.bzl", "cfg_schema")

package(default_visibility = ["//visibility:public"])

# The minimal cfg_schema.h that `./configure --disable-yangmodules` produces.
# The CFG_*_TABLE_NAME macros the library itself uses remain defined inline in schema.h.
#
# The no-YANG configuration selects this through :cfg_schema_default.
genrule(
    name = "cfg_schema_stub",
    outs = ["cfg_schema_stub.h"],
    cmd = """{
echo '#ifndef CFG_SCHEMA_H'
echo '#define CFG_SCHEMA_H'
echo ''
echo '// Minimal cfg_schema.h generated when YANG modules are disabled'
echo '#ifdef __cplusplus'
echo 'namespace swss {'
echo '#endif'
echo ''
echo '#ifdef __cplusplus'
echo '}'
echo '#endif'
echo '#endif'
} > $@""",
    target_compatible_with = select({
        "//tools/bazel:yang_modules_enabled": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

# The standalone Bazel 8 path prepares the production model set and runs the
# same Python schema generator as Make. Bazel 6 callers can continue to supply
# a Make-generated header through --//tools/bazel:cfg_schema.
cfg_schema(
    name = "cfg_schema_generated",
    out = "cfg_schema_generated.h",
    models = "//tools/bazel/yang:yang_models",
)

alias(
    name = "cfg_schema_default",
    actual = select({
        "//tools/bazel:yang_modules_enabled": ":cfg_schema_generated" if IS_BZLMOD else ":cfg_schema_stub",
        "//conditions:default": ":cfg_schema_stub",
    }),
)

# Genrule to import the value of --//tools/bazel:cfg_schema into the build.
#
# It lives in common/ to match common/Makefile.am (BUILT_SOURCES = common/cfg_schema.h).
genrule(
    name = "cfg_schema_h",
    srcs = ["//tools/bazel:cfg_schema"],
    outs = ["cfg_schema.h"],
    cmd = "cp $< $@",
)

# Sources that need libyang, mirroring the YANGMODS conditional in common/Makefile.am.
YANG_SRCS = [
    "decoratorsubscriberstatetable.cpp",
    "decoratortable.cpp",
    "defaultvalueprovider.cpp",
]

# Library sources, excluding the standalone swssloglevel tool sources.
#
# c-api/ is listed separately because glob() does not recurse: "*.cpp" alone
# silently drops the whole C API, which common/Makefile.am builds into the
# library. Nothing fails at build time; the .so just ships without it.
filegroup(
    name = "srcs",
    srcs = glob(
        [
            "*.cpp",
            "c-api/*.cpp",
        ],
        exclude = [
            "loglevel.cpp",
            "loglevel_util.cpp",
        ] + YANG_SRCS,
    ) + select({
        "//tools/bazel:yang_modules_enabled": YANG_SRCS,
        "//conditions:default": [],
    }),
)

# All library headers, including the generated cfg_schema.h.
# c-api/ is spelled out for the same reason as in :srcs above. These install as
# swss/c-api/*.h, matching the layout of the libswsscommon-dev deb.
filegroup(
    name = "hdrs",
    srcs = glob(
        [
            "*.h",
            "*.hpp",
            "c-api/*.h",
        ],
        allow_empty = True,
    ) + [":cfg_schema_h"],
)

# swssloglevel standalone tool sources.
filegroup(
    name = "loglevel_srcs",
    srcs = [
        "loglevel.cpp",
        "loglevel.h",
        "loglevel_util.cpp",
    ],
)

# Redis Lua scripts shipped in the libswsscommon package.
filegroup(
    name = "luas",
    srcs = glob(["*.lua"]),
)

exports_files(["database_config.json"])
