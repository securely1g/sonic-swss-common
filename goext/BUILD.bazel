load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# TODO(bazel-ready): Restore when we only support Bazel 8+
# load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@sonic_build_infra//swig:defs.bzl", "swig_gen_go", "swig_lib_deb")
load("//tools/bazel/armhf:swig.bzl", "armhf_select", "armhf_swig")

SWIG_INTERFACE = "swsscommon.i"

# Extract SWIG library files from apt package for hermetic builds
swig_lib_deb(
    name = "swig_lib",
    data = "@trixie//swig",
    strip_prefix = "usr/share/swig/4.3.0",
)

swig_gen_go(
    name = "swsscommon_go_gen",
    hdrs = [
        "//:hdrs",
    ],
    cxx_out = "swsscommon_wrap.cxx",
    go_out = "swsscommon.go",
    hdr_out = "swsscommon_wrap.h",
    interface = SWIG_INTERFACE,
    swig_lib = ":swig_lib",
)

armhf_swig(
    swig_gen_go,
    name = "swsscommon_armhf_go_gen",
    hdrs = ["//:hdrs"],
    cxx_out = "armhf/swsscommon_wrap.cxx",
    go_out = "armhf/swsscommon.go",
    hdr_out = "armhf/swsscommon_wrap.h",
    interface = SWIG_INTERFACE,
    swig_lib = ":swig_lib",
)

# Wrapper cc_library that links the consolidated shared library and exposes
# swsscommon headers at their bare names (e.g. "dbconnector.h") for CGO.
cc_library(
    name = "swsscommon_cgo_wrapper",
    srcs = ["//:libswsscommon_consolidated.so"],
    hdrs = ["//:all_hdrs"],
    linkopts = [
        # Allow undefined symbols resolved at runtime from the consolidated .so
        "-Wl,--allow-shlib-undefined",
    ],
    # Strip the "common/" path prefix so CGO can #include "dbconnector.h" etc.
    strip_include_prefix = "/common",
    visibility = ["//visibility:public"],
    deps = ["//:common_deps"],
)

# Compile the SWIG-generated C++ wrapper as a cc_library so that transitive
# include paths (hiredis, boost, etc.) propagate correctly. rules_go CGO does
# not propagate include paths from cc_library deps, so compiling the .cxx
# inside go_library would fail to find transitive headers.
cc_library(
    name = "swsscommon_wrap_cc",
    srcs = armhf_select(
        ["swsscommon_wrap.cxx"],
        ["armhf/swsscommon_wrap.cxx"],
    ),
    hdrs = armhf_select(
        ["swsscommon_wrap.h"],
        ["armhf/swsscommon_wrap.h"],
    ),
    copts = ["-fPIC"],
    linkopts = [
        "-Wl,--allow-shlib-undefined",
    ],
    deps = [":swsscommon_cgo_wrapper"],
)

go_library(
    name = "swsscommon",
    srcs = armhf_select(
        ["swsscommon.go"],
        ["armhf/swsscommon.go"],
    ),
    cdeps = [
        ":swsscommon_wrap_cc",
        ":swsscommon_cgo_wrapper",
    ],
    cgo = True,
    clinkopts = armhf_select(
        ["-fuse-ld=bfd"],
        ["-fuse-ld=lld"],
    ),
    importpath = "github.com/sonic-net/sonic-swss-common/goext",
    visibility = ["//visibility:public"],
)

go_test(
    name = "swsscommon_runtime_test_binary",
    srcs = ["swsscommon_runtime_test.go"],
    embed = [":swsscommon"],
    tags = ["manual"],
)

# rules_go's interface-library handling does not add all versioned distro
# libraries to runfiles. Exercise the consumer with declared Trixie runtime
# dependencies, matching the installed environment used by SONiC.
sh_test(
    name = "swsscommon_runtime_test",
    srcs = ["//tools/bazel/runtime:run_with_runtime.py"],
    args = armhf_select(
        [],
        ["--qemu-arm"],
    ) + [
        "$(location //tools/bazel/runtime:test_runtime)",
        "$(location //:libswsscommon_consolidated.so)",
    ] + select({
        "//tools/bazel:yang_modules_enabled": ["enabled"],
        "//conditions:default": ["disabled"],
    }) + ["$(location :swsscommon_runtime_test_binary)"],
    data = [
        ":swsscommon_runtime_test_binary",
        "//:libswsscommon_consolidated.so",
        "//tools/bazel/runtime:test_runtime",
    ],
)

go_test(
    name = "swsscommon_test",
    srcs = ["swsscommon_test.go"],
    embed = [":swsscommon"],
    tags = ["manual"],
)
