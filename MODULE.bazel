# Keep bazel_compatibility in sync with sonic-buildimage's .bazelversion.
module(
    name = "sonic-swss-common",
    version = "0.0.0",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)
bazel_dep(name = "cppzmq", version = "4.10.0.bcr.1", dev_dependency = True)
bazel_dep(name = "toolchains_llvm", version = "1.5.0", dev_dependency = True)

bazel_dep(name = "googletest", version = "1.11.0", repo_name = "com_google_googletest")
bazel_dep(name = "glog", version = "0.5.0", repo_name = "com_github_google_glog")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_rust_bindgen", version = "0.74.0")
bazel_dep(name = "rules_go", version = "0.60.0.sonic-patched", repo_name = "io_bazel_rules_go")
bazel_dep(name = "rules_cc", version = "0.2.8")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "tar.bzl", version = "0.10.5")
bazel_dep(name = "rules_distroless", version = "0.9.4")
bazel_dep(name = "libyang", version = "3.12.2.sonic.1")
bazel_dep(name = "libnl3", version = "3.7.0.sonic-buildimage")
bazel_dep(name = "sonic-build-infra", version = "0.0.6-553b2f70f9ba77b74befdf77674894166139ddcc", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-yang-mgmt", version = "1.0.0-9ab452d22773c41783092ae3bd6c206d6c257c8d", repo_name = "sonic_yang_mgmt")
bazel_dep(name = "sonic-yang-models", version = "1.0.0-9ab452d22773c41783092ae3bd6c206d6c257c8d", repo_name = "sonic_yang_models")

# Schema generation runs on the execution platform with a declared Python
# runtime. Its native CFFI binding uses headers from that interpreter toolchain.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13")
use_repo(python, "python_3_13")

register_toolchains("@python_3_13//:all")

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

# Standalone validation selects the same Rust and bindgen tools as SWSS. These
# root-only toolchain choices are ignored when Common is a dependency; the
# consuming root provides its own registered Rust and bindgen toolchains.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(
    edition = "2021",
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(llvm_version = "17.0.6")
use_repo(llvm, "llvm_toolchain_llvm")

register_toolchains(
    "//tools/bazel/rust/dev:bindgen_toolchain",
    dev_dependency = True,
)

# Common owns the Rust library's third-party dependencies as well as its C API.
# Ship crate_universe metadata so other Bazel modules can use the library.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

# Serde traits cross Common's public API. Enable the additional feature used by
# downstream SWSS without changing Common's Cargo manifest.
crate.annotation(
    crate = "serde",
    crate_features = ["alloc"],
)
crate.annotation(
    crate = "serde_core",
    crate_features = ["alloc"],
)
crate.from_cargo(
    name = "swss_common_crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:Cargo.Bazel.lock",
    manifests = ["//:Cargo.toml"],
    skip_cargo_lockfile_overwrite = True,
    supported_platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
    ],
)

# serde_core is transitive in Cargo, so crate_universe does not emit a hub alias.
# Import the locked spoke to expose the same crate identity to Rust consumers.
use_repo(
    crate,
    crates = "swss_common_crates",
    serde_core = "swss_common_crates__serde_core-1.0.228",
)

# The actual dependencies are listed in sonic-build-infra, and re-exported.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
use_repo(apt, "trixie")
