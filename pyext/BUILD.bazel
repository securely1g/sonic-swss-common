# TODO(bazel-ready): Restore when we only support Bazel 8+
# load("@rules_cc//cc:cc_library.bzl", "cc_library")
# load("@rules_cc//cc:defs.bzl", "cc_binary")
# load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@sonic_build_infra//python:py_native_library.bzl", "py_native_library")
load("@sonic_build_infra//swig:defs.bzl", "swig_gen", "swig_lib_deb")
load("@sonic_build_infra//tar:sonic_deploy_tar.bzl", "sonic_deploy_tar")
load("//tools/bazel:swig.bzl", "swig_interface")

# Extract SWIG library files from apt package for hermetic builds
swig_lib_deb(
    name = "swig_lib",
    data = "@trixie//swig",
    strip_prefix = "usr/share/swig/4.3.0",
)

exports_files(["swsscommon.i"])

# Pass the feature define through a declared interface adapter. The source
# interface is also a header input to the SWIG action below.
swig_interface(
    name = "swsscommon_bazel_interface",
    out = "swsscommon_bazel.i",
    defines = select({
        "//tools/bazel:yang_modules_enabled": ["ENABLE_YANG_MODULES"],
        "//conditions:default": [],
    }),
    interface = "swsscommon.i",
)

swig_gen(
    name = "swsscommon_pyy",
    hdrs = [
        "swsscommon.i",
        "//:hdrs",
    ],
    cpp_out = "py3/swsscommon_wrap.cpp",
    interface = ":swsscommon_bazel_interface",
    python_out = "py3/swsscommon.py",
    swig_lib = ":swig_lib",
)

cc_library(
    name = "swsscommonwrap",
    srcs = ["py3/swsscommon_wrap.cpp"],  # Generated by SWIG
    copts = select({
        "//tools/bazel:yang_modules_enabled": ["-DENABLE_YANG_MODULES"],
        "//conditions:default": [],
    }),
    deps = [
        "//:libswsscommon",
        "@trixie//python3-dev:python3",
    ],
)

cc_binary(
    name = "_swsscommon",
    srcs = ["py3/swsscommon_wrap.cpp"],  # Generated by SWIG
    copts = [
        "-fvisibility=hidden",
        "-fPIC",
    ] + select({
        "//tools/bazel:yang_modules_enabled": ["-DENABLE_YANG_MODULES"],
        "//conditions:default": [],
    }),
    linkshared = 1,
    linkstatic = 1,
    deps = [
        "//:libswsscommon",
        "@trixie//python3-dev:python3",
    ],
)

# Python library wrapping the native swsscommon extension
py_native_library(
    name = "swsscommon",
    cc_deps = [
        "//:common",
        "@trixie//python3-dev:python3",
    ],
    native_py = "py3/swsscommon.py",
    native_so = ":_swsscommon",
    visibility = ["//visibility:public"],
)

# Backwards compatibility alias
alias(
    name = "pyext",
    actual = ":swsscommon",
    visibility = ["//visibility:public"],
)

# Installed packages use normal Python imports and the image's dynamic loader.
# The separate :swsscommon target keeps its Bazel runfiles behavior.
write_file(
    name = "installed_init_py",
    out = "installed/__init__.py",
    content = [
        "# AUTO-GENERATED by pyext/BUILD.bazel. DO NOT EDIT MANUALLY.",
        "from .swsscommon import *",
        "",
    ],
)

sonic_deploy_tar(
    name = "swsscommon_pkg",
    srcs = [
        "py3/swsscommon.py",
        ":installed_init_py",
    ],
    out = "swsscommon_pkg.tar.gz",
    binaries = {
        "usr/lib/python3/dist-packages/swsscommon/lib_swsscommon.so type=file mode=0755": ":_swsscommon",
    },
    compress = "gzip",
    force_debug_build = True,
    mtree = [
        "usr/lib/python3/dist-packages/swsscommon/__init__.py type=file mode=0644 content=$(location :installed_init_py)",
        "usr/lib/python3/dist-packages/swsscommon/swsscommon.py type=file mode=0644 content=$(location py3/swsscommon.py)",
        "usr/lib/python3/dist-packages/swsscommon/_swsscommon.so type=link time=0 link=lib_swsscommon.so",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "swsscommon_package_test",
    srcs = ["swsscommon_package_test.py"],
    args = [
        "$(location //tools/bazel/runtime:run_with_runtime)",
        "$(location //tools/bazel/runtime:test_runtime)",
        "$(location :swsscommon_pkg)",
        "$(location :swsscommon_pkg.debug_symbols)",
    ] + select({
        "//tools/bazel:yang_modules_enabled": ["enabled"],
        "//conditions:default": ["disabled"],
    }),
    data = [
        ":swsscommon_pkg",
        ":swsscommon_pkg.debug_symbols",
        "//tools/bazel/runtime:run_with_runtime",
        "//tools/bazel/runtime:test_runtime",
    ],
)

filegroup(
    name = "swsscommon_dist",
    srcs = [
        ":swsscommon_pkg",
        "@trixie//python3-dev",
    ],
    visibility = ["//visibility:public"],
)
