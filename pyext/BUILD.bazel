# TODO(bazel-ready): Restore when we only support Bazel 8+
# load("@rules_cc//cc:cc_library.bzl", "cc_library")
# load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("@sonic_build_infra//python:py_native_library.bzl", "py_native_library")
load("@sonic_build_infra//swig:defs.bzl", "swig_gen", "swig_lib_deb")
load("//tools/bazel/armhf:swig.bzl", "armhf_select", "armhf_swig")

SWIG_INTERFACE = "swsscommon.i"

# Extract SWIG library files from apt package for hermetic builds
swig_lib_deb(
    name = "swig_lib",
    data = "@trixie//swig",
    strip_prefix = "usr/share/swig/4.3.0",
)

exports_files(["swsscommon.i"])

swig_gen(
    name = "swsscommon_pyy",
    hdrs = [
        "//:hdrs",
    ],
    cpp_out = "py3/swsscommon_wrap.cpp",
    interface = SWIG_INTERFACE,
    python_out = "py3/swsscommon.py",
    swig_lib = ":swig_lib",
)

armhf_swig(
    swig_gen,
    name = "swsscommon_armhf_pyy",
    hdrs = ["//:hdrs"],
    cpp_out = "armhf/py3/swsscommon_wrap.cpp",
    defines = select({
        "//tools/bazel:yang_modules_enabled": ["ENABLE_YANG_MODULES"],
        "//conditions:default": [],
    }),
    interface = "swsscommon.i",
    python_out = "armhf/py3/swsscommon.py",
    swig_lib = ":swig_lib",
)

cc_library(
    name = "swsscommonwrap",
    srcs = armhf_select(
        ["py3/swsscommon_wrap.cpp"],
        ["armhf/py3/swsscommon_wrap.cpp"],
    ),
    deps = [
        "//:libswsscommon",
        "@trixie//python3-dev:python3",
    ],
)

cc_binary(
    name = "_swsscommon",
    srcs = armhf_select(
        ["py3/swsscommon_wrap.cpp"],
        ["armhf/py3/swsscommon_wrap.cpp"],
    ),
    copts = [
        "-fvisibility=hidden",
        "-fPIC",
    ],
    linkshared = 1,
    linkstatic = 1,
    deps = [
        "//:libswsscommon",
        "@trixie//python3-dev:python3",
    ],
)

# Python library wrapping the native swsscommon extension
py_native_library(
    name = "swsscommon",
    cc_deps = [
        "//:common",
        "@trixie//python3-dev:python3",
    ],
    native_py = armhf_select("py3/swsscommon.py", "armhf/py3/swsscommon.py"),
    native_so = ":_swsscommon",
    visibility = ["//visibility:public"],
)

# Backwards compatibility alias
alias(
    name = "pyext",
    actual = ":swsscommon",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "swsscommon_pkg",
    srcs = [
        ":_swsscommon",
        ":swsscommon",
    ],
    # TODO: exclude lib_swsscommon_lib.a
    extension = "tar.gz",
    mode = "0755",
    package_dir = "/usr/lib/python3/dist-packages/swsscommon",
    symlinks = {
        # __init__.py looks for _swsscommon.so in the same directory
        "_swsscommon.so": "lib_swsscommon.so",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "swsscommon_dist",
    srcs = [
        ":swsscommon_pkg",
        "@trixie//python3-dev",
    ],
    visibility = ["//visibility:public"],
)
