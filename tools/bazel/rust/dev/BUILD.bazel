load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_cc//cc:defs.bzl", "cc_import")
load("@rules_rust_bindgen//:defs.bzl", "rust_bindgen_toolchain")

# This standalone validation toolchain is registered only when Common is the
# root module. Downstream roots choose their own compatible bindgen toolchain.
native_binary(
    name = "clang",
    src = "@llvm_toolchain_llvm//:bin/clang",
)

cc_import(
    name = "libclang",
    shared_library = "@llvm_toolchain_llvm//:libclang",
)

rust_bindgen_toolchain(
    name = "bindgen_toolchain_impl",
    # rules_rust_bindgen 0.74.0 supplies bindgen 0.71.1. Cargo's build.rs
    # remains on bindgen 0.70.1; downstream Rust compilation validates the
    # generated API rather than claiming byte-identical generator output.
    bindgen = "@rules_rust_bindgen//3rdparty:bindgen",
    clang = ":clang",
    libclang = ":libclang",
)

toolchain(
    name = "bindgen_toolchain",
    toolchain = ":bindgen_toolchain_impl",
    toolchain_type = "@rules_rust_bindgen//:toolchain_type",
)
